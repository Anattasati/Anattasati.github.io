---
import ObservationIndex from "../../components/ObservationIndex.astro";
import VoidLayout from "../../layouts/VoidLayout.astro";
import { getPostsByCategory } from "../../lib/content";

const posts = await getPostsByCategory("meditations");
const description = "Practices and fragments for returning to the present moment.";
---

<VoidLayout
  title="Meditations"
  description={description}
  currentSection="meditations"
  canonicalPath="/meditations/"
  variant="section"
>
  <section class="section-index" aria-labelledby="section-title">
    <header class="section-header">
      <p class="eyebrow">
        <span>02</span>
        <span>Practice index</span>
      </p>
      <h1 id="section-title">Meditations</h1>
      <p class="section-description">{description}</p>
      <p class="section-count">
        <span>{String(posts.length).padStart(2, "0")}</span>
        {posts.length === 1 ? "entry" : "entries"}
      </p>
    </header>

    <ObservationIndex posts={posts} emptyLabel="The first meditation has yet to arise." />
  </section>
</VoidLayout>
