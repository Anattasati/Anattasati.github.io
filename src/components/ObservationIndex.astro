---
import type { CollectionEntry } from "astro:content";
import { formatPostDate, getPostPath } from "../lib/content";

interface Props {
  posts: CollectionEntry<"posts">[];
  emptyLabel?: string;
}

const { posts, emptyLabel = "No observations yet." } = Astro.props;
---

{
  posts.length > 0 ? (
    <ol class="observation-list">
      {posts.map((post, index) => {
        const number = String(index + 1).padStart(2, "0");
        const dateLabel = formatPostDate(post.data.date);

        return (
          <li>
            <a
              class="observation-link"
              href={getPostPath(post)}
              data-luminous-target={`observation-${number}`}
            >
              <span class="observation-number" aria-hidden="true">{number}</span>
              <span class="observation-title">{post.data.title}</span>
              <time datetime={post.data.date.toISOString()}>
                <span aria-hidden="true">{post.data.date.getUTCFullYear()}</span>
                <span class="sr-only">{dateLabel}</span>
              </time>
              <svg class="observation-arrow" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M5 12h14m-5-5 5 5-5 5" />
              </svg>
            </a>
          </li>
        );
      })}
    </ol>
  ) : (
    <p class="observation-empty">{emptyLabel}</p>
  )
}
