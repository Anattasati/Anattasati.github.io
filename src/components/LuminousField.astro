---
interface Props {
  class?: string;
  mode?: "void" | "reading";
}

const { class: className, mode = "void" } = Astro.props;
---

<div
  class:list={["luminous-field", className]}
  data-luminous-field
  data-mode={mode}
  aria-hidden="true"
  transition:persist="luminous-field"
>
  <canvas data-luminous-canvas tabindex="-1"></canvas>
</div>

<script>
  import { initializeLuminousField } from "../scripts/luminous-field";

  initializeLuminousField();
</script>

<style>
  .luminous-field {
    --luminous-reading-width: 680;
    --luminous-reading-gutter: 38;

    position: fixed;
    z-index: var(--luminous-field-z, 0);
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    isolation: isolate;
    contain: strict;
    background-color: #08090a;
    transition: background-color 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .luminous-field::before {
    position: absolute;
    z-index: -1;
    inset: -20%;
    background:
      radial-gradient(circle at 67% 31%, rgb(170 184 255 / 3.5%), transparent 34%),
      radial-gradient(circle at 28% 72%, rgb(139 233 208 / 2.5%), transparent 38%);
    content: "";
    opacity: 1;
    transition: opacity 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .luminous-field[data-mode="reading"] {
    background-color: #ecebe5;
  }

  .luminous-field[data-mode="reading"]::before {
    opacity: 0.22;
  }

  canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .luminous-field,
    .luminous-field::before {
      transition-duration: 1ms;
    }
  }
</style>
