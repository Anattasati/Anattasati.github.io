---
import BaseLayout from "./BaseLayout.astro";
import { formatPostDate } from "../lib/content";

interface Props {
  title: string;
  description?: string;
  date: Date;
  category: "reflections" | "meditations";
  canonicalPath: string;
}

const { title, description, date, category, canonicalPath } = Astro.props;
const categoryLabel = category === "reflections" ? "Reflections" : "Meditations";
const categoryPath = `/${category}/`;
const publishedDate = formatPostDate(date);
---

<BaseLayout
  title={title}
  description={description ?? `${title}, from ${categoryLabel.toLowerCase()} at Anattasati.`}
  surface="reading"
  canonicalPath={canonicalPath}
>
  <div class="reading-shell">
    <header class="reading-masthead">
      <a class="wordmark wordmark--ink" href="/" aria-label="Anattasati, home">
        <span class="site-mark" aria-hidden="true"><span></span></span>
        <span class="wordmark__text">Anattasati</span>
      </a>

      <a
        class="reading-return"
        href={categoryPath}
        aria-label={`All ${categoryLabel.toLowerCase()}`}
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M19 12H5m6-6-6 6 6 6" />
        </svg>
        <span>All {categoryLabel.toLowerCase()}</span>
      </a>
    </header>

    <div class="reading-progress" aria-hidden="true">
      <span class="reading-progress__track"></span>
      <span class="reading-progress__point"></span>
    </div>

    <main id="main-content" class="reading-main" transition:name="page-content" transition:animate="fade">
      <article class="reading-article" aria-labelledby="article-title">
        <header class="article-header">
          <div class="article-meta">
            <a href={categoryPath}>{categoryLabel}</a>
            <span aria-hidden="true">/</span>
            <time datetime={date.toISOString()}>{publishedDate}</time>
          </div>
          <h1 id="article-title">{title}</h1>
          {description && <p class="article-deck">{description}</p>}
        </header>

        <div class="reading-body">
          <slot />
        </div>

        <footer class="article-footer">
          <span class="article-end" aria-hidden="true"><span></span></span>
          <p>End of observation</p>
          <a href={categoryPath}>Return to {categoryLabel.toLowerCase()}</a>
        </footer>
      </article>
    </main>
  </div>
</BaseLayout>

<script>
  type ProgressWindow = Window & {
    __anattasatiProgressCleanup?: () => void;
  };

  const setupReadingProgress = () => {
    const progress = document.querySelector<HTMLElement>(".reading-progress");
    const progressWindow = window as ProgressWindow;

    progressWindow.__anattasatiProgressCleanup?.();
    if (!progress) return;

    const update = () => {
      const scrollRange = document.documentElement.scrollHeight - window.innerHeight;
      const value = scrollRange > 0 ? window.scrollY / scrollRange : 0;
      progress.style.setProperty("--reading-progress", String(Math.min(1, Math.max(0, value))));
    };

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    progressWindow.__anattasatiProgressCleanup = () => {
      window.removeEventListener("scroll", update);
      window.removeEventListener("resize", update);
    };
    update();
  };

  document.addEventListener("astro:page-load", setupReadingProgress);
</script>
